<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.infinite.jsf.provider.model">

    <class name="PaymentHistory" table="payment_history">

        <id name="paymentId" column="payment_id">
            <generator class="native"/>
        </id>

       

        <many-to-one name="recipient" class="com.infinite.jsf.recipient.model.Recipient" column="h_id" not-null="true" insert="false" update="false" fetch="join" lazy="false"/>

        <many-to-one name="provider" class="com.infinite.jsf.provider.model.Provider" column="provider_id" not-null="true" fetch="join" lazy="false"/>

        <property name="amount" column="amount" not-null="true"/>

        <property name="paymentMethod" column="payment_method"/>

        <property name="paymentStatus" column="payment_status"/>

        <property name="paymentDate" column="payment_date"/>

        <property name="remarks" column="remarks"/>

    </class>

</hibernate-mapping>
