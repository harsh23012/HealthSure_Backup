<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.infinite.jsf.provider.model.PasswordHistory"
		table="provider_password_history">
		<id name="id" column="password_id">
			<generator class="native" />
		</id>
		<many-to-one name="provider" column="provider_id"
			class="com.infinite.jsf.provider.model.Provider" not-null="true" />
		<property name="passwordHash" column="password_hash"
			not-null="true" />
		<property name="createdAt" column="created_at"
			type="timestamp" not-null="true" />
	</class>
</hibernate-mapping>
 